# Backend Server Configuration (Render / Local Development)
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String (Replica set required for multi-document transactions)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gokul_ghee?retryWrites=true&w=majority

# CORS Allowed Origin (Comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Authentication Secrets (Use strong 64+ char random secrets in production)
JWT_ACCESS_SECRET=replace_with_secure_random_access_secret_64_chars
JWT_REFRESH_SECRET=replace_with_secure_random_refresh_secret_64_chars
JWT_ACCESS_EXPIRES_IN=1d
COOKIE_SECURE=false

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payments (Phase 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini & Maps APIs (Phase 6)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MAPS_SERVER_API_KEY=
