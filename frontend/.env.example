# Public Frontend Environment Variables (Vercel)
# Never put private API secrets (Gemini, Razorpay secret, Cloudinary secret) in frontend env.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_STORE_PLACE_ID=ChIJ53Oz9XZX7TkRW_5zLDQrlaI
# Cloudflare Turnstile (optional; shows free in-house visual captcha fallback when omitted)
VITE_TURNSTILE_SITE_KEY=
# Google OAuth 2.0 Web Client ID (from Google Cloud Console > Credentials)
VITE_GOOGLE_CLIENT_ID=
